{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Normalizer": {
    "Enabled": true,
    "ProjectionVersion": 1,
    "BatchSize": 500,
    "IdleDelay": "00:00:00.250",
    "ClaimTimeout": "00:05:00",
    "ShutdownTimeout": "00:00:30"
  }
}
